{
  "name": "nextjs-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out test-results playwright-report vitest-test-results .vitest-attachments storybook-static",
    "check": "npm run typecheck && run-p --aggregate-output --continue-on-error lint format:check check:*",
    "verify": "run-s check test test:storybook test:rls test:db test:e2e",
    "typecheck": "next typegen && tsc --noEmit --pretty",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "check:migrations": "drizzle-kit check",
    "test": "vitest run --project unit --project ui",
    "test:db": "vitest run --project db",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:rls": "supabase test db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "supabase migration up",
    "release": "semantic-release"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.1",
    "@logtape/logtape": "2.4.2",
    "@logtape/redaction": "2.4.2",
    "@sentry/nextjs": "10.77.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "next-intl": "4.13.4",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.91.0",
    "translation-resilience": "0.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.12",
    "conventional-changelog-conventionalcommits": "10.3.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "storybook": "10.6.5",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vitest": "4.1.12",
    "vitest-browser-react": "2.2.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
