{
  "name": "nextjs-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "typecheck": "next typegen && tsc --noEmit --pretty",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rls": "supabase test db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/Database.ts && oxfmt src/types/Database.ts"
  },
  "dependencies": {
    "@logtape/logtape": "2.3.1",
    "@sentry/nextjs": "10.70.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "next": "16.4.0",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "translation-resilience": "0.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
