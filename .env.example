# Copy to `.env.local` (git-ignored): cp .env.example .env.local
# The Supabase values below are the fixed local defaults printed by `npm run db:start`.
# For hosted environments, set real values in your platform's environment settings.
# Never commit secrets. The app does not need the Supabase secret/service-role key;
# DATABASE_URL is the only server-side secret.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Postgres connection used by Drizzle on the server (required, secret in hosted environments).
# Local default below; for hosted Supabase use the pooler connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Public base URL used for auth email links, sitemap and robots (required).
# Set the production URL in hosted environments, otherwise email links point to localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log level: trace | debug | info | warning | error | fatal (optional, default info)
NEXT_PUBLIC_LOGGING_LEVEL=debug

# Disable Next.js telemetry (optional)
NEXT_TELEMETRY_DISABLED=1

# Set by CI providers; shows the Sentry build plugin output (optional, leave unset locally)
# CI=true

# Sentry error monitoring (optional; Sentry is off when the DSN is empty)
# NEXT_PUBLIC_SENTRY_DSN=
# Build-time source map upload (optional; keep the token secret, e.g. in CI secrets)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
