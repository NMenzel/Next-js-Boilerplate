# Copy to `.env.local` (git-ignored): cp .env.example .env.local
# The Supabase values below are the fixed local defaults printed by `npm run db:start`.
# For hosted environments, set real values in your platform's environment settings.
# Never commit secrets. This app does not need the Supabase secret/service-role key.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Public base URL used for auth email links, sitemap and robots (optional, default http://localhost:3000)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log level: trace | debug | info | warning | error | fatal (optional, default info)
NEXT_PUBLIC_LOGGING_LEVEL=debug

# Disable Next.js telemetry (optional)
NEXT_TELEMETRY_DISABLED=1
