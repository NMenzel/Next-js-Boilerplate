{
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "search.exclude": {
    "package-lock.json": true,
    "src/types/Database.ts": true
  },

  // TypeScript
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    // Import Link, redirect and usePathname from `@/libs/I18nNavigation` instead of Next.js
    "next/router",
    "next/link",
    // Not used in the project and conflicts with `use()` from React
    "chai",
    // Use Zod v4 instead of v3
    "zod/v3",
    // Sentry is imported with `import *`
    "@sentry/nextjs"
  ],

  // Vitest
  "testing.automaticallyOpenTestResults": "neverOpen",

  // I18n
  "i18n-ally.localesPaths": ["src/locales"],
  "i18n-ally.keystyle": "nested",

  // Oxc (lint + format)
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "oxc.typeAware": true,
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.fixAll.oxc": "explicit"
  }
}
